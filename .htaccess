# SimorghBot - تنظیمات Apache (cPanel)
Options -Indexes

RewriteEngine On
# /api/me  ->  api.php?r=me
RewriteRule ^api/(.*)$ api.php?r=$1 [QSA,L]

# فایل‌های حساس قابل دانلود نباشند
<FilesMatch "^(config\.php|installed\.lock)$">
    Require all denied
</FilesMatch>

# ---------- امنیت ----------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag expose_php off
</IfModule>
# فایل‌های داخلی، پشتیبان‌ها و لاگ‌ها هرگز قابل دانلود نباشند
<FilesMatch "\.(sql|gz|md|log|bak|tmp|ini|env|zip|tar)$">
    Require all denied
</FilesMatch>
<DirectoryMatch "/(src|storage|\.git)(/|$)">
    Require all denied
</DirectoryMatch>
